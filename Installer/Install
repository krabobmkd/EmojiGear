; EmojiGear Installer Script
; For use with the standard Amiga 'Installer' tool (v43+).
;
; Always installs:
;   - utf8rastport.library  -> Libs:
;   - unitexteditor.gadget  -> SYS:Classes/Gadgets/
;   - unibutton.gadget      -> SYS:Classes/Gadgets/
;   - 4 TrueType fonts      -> Fonts:
;
; Optional (user selects):
;   - EmojiGear             (requires AmigaOS 3.2 or later)
;   - MUImojiGear           (AmigaOS 3.0-3.9 compatible, requires MUI 3.8+)
;   - example text files    -> <dest>/examples_text/
;   - SDK
;

(set #app-name    "EmojiGear")
(set #app-version "v5.3")
(set #app-default "Work:")

; Library/gadget versions we are shipping
(set #urp-ver   (+ (* 4 65536) 3))   ; utf8rastport.library  v5.2
(set #uted-ver  (+ (* 4 65536) 3))   ; unitexteditor.gadget  v5.3
(set #ubtn-ver  (+ (* 4 65536) 3))   ; unibutton.gadget      v5.1

; ---------------------------------------------------------------------------
; Welcome
; ---------------------------------------------------------------------------
(message
    (cat
        "Welcome to the " #app-name " " #app-version " installer!\n\n"
        "This package brings full Unicode and Emoji rendering to your\n"
        "Amiga, powered by FreeType 2.  Two applications are included:\n\n"
        "  EmojiGear     -- requires AmigaOS 3.2 or later\n"
        "  MUImojiGear   -- compatible with AmigaOS 3.0 to 3.9\n"
        "                   (requires MUI 3.8 or later)\n\n"
        "The shared components will always be installed.\n\n"
        "Click Proceed to choose what to install."
    )
    (all)
)

; ---------------------------------------------------------------------------
; Choose which applications to install
; (askoptions returns a bitmask: bit 0 = EmojiGear, bit 1 = MUImojiGear)
; ---------------------------------------------------------------------------
(set #install-apps
    (askoptions
        (prompt
            (cat
                "Which applications would you like to install?\n\n"
                "The shared library and gadgets are always installed\n"
                "regardless of your choice here."
            )
        )
        (help
            (cat
                "EmojiGear:\n"
                "  The full-featured editor with multi-file tab support,\n"
                "  Find & Replace, and all settings.\n"
                "  Requires AmigaOS 3.2 or later.\n\n"
                "MUImojiGear:\n"
                "  A MUI-based variant that runs on AmigaOS 3.0 to 3.9.\n"
                "  Requires MUI 3.8 or later.\n"
                "  Note: may cause instability at quit on OS 3.9 due to a\n"
                "  known layers.library bug fixed only in OS 3.2.\n\n"
                "You may install both at the same time."
            )
        )
        (choices
            "EmojiGear  (requires AmigaOS 3.2 or later)"
            "MUImojiGear  (AmigaOS 3.0-3.9, requires MUI 3.8+)"
        )
        (default 3)
    )
)

; ---------------------------------------------------------------------------
; Choose installation directory
; ---------------------------------------------------------------------------
(set #parent
    (askdir
        (prompt
            (cat "Where would you like to install " #app-name "?")
        )
        (help
            (cat
                "Choose a drawer for the installation.\n"
                "A '" #app-name "' drawer will be created inside it.\n\n"
                "Default: " #app-default #app-name
            )
        )
        (default #app-default)
    )
)

(set #dest (tackon #parent #app-name))

(complete 5)

; ---------------------------------------------------------------------------
; Install utf8rastport.library -> Libs:
; ---------------------------------------------------------------------------
(set #urp-installed (getversion "Libs:utf8rastport.library"))

; -- VERSION GATE (disabled for v5.2: always install) -------------------------
; To re-enable version checking, remove the unconditional block below and
; uncomment the if block:
;(if (>= #urp-installed #urp-ver)
;    (
;        (message
;            (cat
;                "utf8rastport.library v"
;                (/ #urp-installed 65536)
;                " is already installed and is at least as recent as\n"
;                "the one included here.  Skipping -- your version wins!\n"
;            )
;        )
;    )
;    (
;        (working "Installing utf8rastport.library to Libs: ...")
;        (copyfiles
;            (source "bin/utf8rastport.library")
;            (dest "Libs:")
;        )
;    )
;)
(working "Installing utf8rastport.library to Libs: ...")
(copyfiles
    (source "bin/utf8rastport.library")
    (dest "Libs:")
)
; -- end version gate ----------------------------------------------------------

(complete 20)

; ---------------------------------------------------------------------------
; Install unitexteditor.gadget -> SYS:Classes/Gadgets/
; ---------------------------------------------------------------------------
(set #uted-dest "SYS:Classes/Gadgets/")
(set #uted-installed (getversion (tackon #uted-dest "unitexteditor.gadget")))

; -- VERSION GATE (disabled for v5.2: always install) -------------------------
; To re-enable version checking, remove the unconditional block below and
; uncomment the if block:
;(if (>= #uted-installed #uted-ver)
;    (
;        (message
;            (cat
;                "unitexteditor.gadget v"
;                (/ #uted-installed 65536)
;                " is already installed and is at least as recent.\n"
;                "Skipping -- steady on!"
;            )
;        )
;    )
;    (
;        (working "Installing unitexteditor.gadget to SYS:Classes/Gadgets/ ...")
;        (makedir #uted-dest)
;        (copyfiles
;            (source "bin/unitexteditor.gadget")
;            (dest #uted-dest)
;        )
;    )
;)
(working "Installing unitexteditor.gadget to SYS:Classes/Gadgets/ ...")
(makedir #uted-dest)
(copyfiles
    (source "bin/unitexteditor.gadget")
    (dest #uted-dest)
)
; -- end version gate ----------------------------------------------------------

(complete 35)

; ---------------------------------------------------------------------------
; Install unibutton.gadget -> SYS:Classes/Gadgets/
; ---------------------------------------------------------------------------
(set #ubtn-installed (getversion (tackon #uted-dest "unibutton.gadget")))

; -- VERSION GATE (disabled for v5.2: always install) -------------------------
; To re-enable version checking, remove the unconditional block below and
; uncomment the if block:
;(if (>= #ubtn-installed #ubtn-ver)
;    (
;        (message
;            (cat
;                "unibutton.gadget v"
;                (/ #ubtn-installed 65536)
;                " is already installed and is at least as recent.\n"
;                "Skipping!"
;            )
;        )
;    )
;    (
;        (working "Installing unibutton.gadget to SYS:Classes/Gadgets/ ...")
;        (copyfiles
;            (source "bin/unibutton.gadget")
;            (dest #uted-dest)
;        )
;    )
;)
(working "Installing unibutton.gadget to SYS:Classes/Gadgets/ ...")
(copyfiles
    (source "bin/unibutton.gadget")
    (dest #uted-dest)
)
; -- end version gate ----------------------------------------------------------

(complete 50)

; ---------------------------------------------------------------------------
; Install TrueType fonts -> Fonts:
; ---------------------------------------------------------------------------
(working "Installing TrueType fonts to Fonts: ...")

(copyfiles
    (source "Fonts/LiberationSans-Regular.ttf")
    (dest "Fonts:")
)
(copyfiles
    (source "Fonts/NotoColorEmoji32.ttf")
    (dest "Fonts:")
)
(copyfiles
    (source "Fonts/OpenMoji-black-glyf.ttf")
    (dest "Fonts:")
)
(copyfiles
    (source "Fonts/UbuntuMono-Regular.ttf")
    (dest "Fonts:")
)

(complete 60)

; ---------------------------------------------------------------------------
; Create destination drawer and install selected applications
; ---------------------------------------------------------------------------
(working (cat "Creating " #dest " ..."))
(makedir #dest)

(working "Copying documentation ...")
(copyfiles
    (source "EmojiGear.guide")
    (dest #dest)
    (infos)
)
(copyfiles
    (source "LICENSE")
    (dest #dest)
)

; --- EmojiGear (bit 0) ------------------------------------------------------
(if (BITAND #install-apps 1)
    (
        (working "Copying EmojiGear ...")
        (copyfiles
            (source "bin/EmojiGear")
            (dest #dest)
        )
    )
)

; --- MUImojiGear (bit 1) ----------------------------------------------------
(if (BITAND #install-apps 2)
    (
        (working "Copying MUImojiGear ...")
        (copyfiles
            (source "bin/MUImojiGear")
            (dest #dest)
        )
    )
)

(complete 75)

; ---------------------------------------------------------------------------
; Optional: example text files
; ---------------------------------------------------------------------------
(set #install-examples
    (askbool
        (prompt
            (cat
                "Would you like to install example text files?\n\n"
                "These include UTF-8, Latin-1, Latin-2, ANSI colour,\n"
                "UTF-16, and multilingual samples -- a little tour of the\n"
                "Unicode universe, Amiga-style."
            )
        )
        (help
            (cat
                "Example files will be placed in:\n"
                #dest "/examples_text/\n\n"
                "They are purely optional but handy for testing fonts\n"
                "and getting a feel for what EmojiGear can display."
            )
        )
        (default 1)
    )
)

(if (= #install-examples 1)
    (
        (set #ex-dest (tackon #dest "examples_text"))
        (working "Creating examples_text drawer ...")
        (makedir #ex-dest)
        (working "Copying example text files ...")
        (copyfiles
            (source "examples_text")
            (dest #ex-dest)
            (all)
        )
    )
)

(complete 88)

; ---------------------------------------------------------------------------
; Optional: SDK
; ---------------------------------------------------------------------------
(set #install-sdk
    (askbool
        (prompt
            (cat
                "Would you like to install the EmojiGear SDK?\n\n"
                "The SDK contains everything you need to build your own\n"
                "applications using utf8rastport.library, unitexteditor.gadget\n"
                "and unibutton.gadget:\n\n"
                "  include/  -- C header files\n"
                "  clib/     -- function prototypes\n"
                "  inline/   -- GCC inline stubs\n"
                "  pragmas/  -- SAS/C pragmas\n"
                "  sfd/      -- SFD function descriptor files\n"
                "  autodocs/ -- API documentation\n"
                "  examples/ -- example source code"
            )
        )
        (help
            (cat
                "The SDK will be copied into the directory you choose.\n"
                "A sub-drawer 'EmojiGearSDK' will be created inside it."
            )
        )
        (default 0)
    )
)

(if (= #install-sdk 1)
    (
        (set #sdk-parent
            (askdir
                (prompt "Where would you like to install the EmojiGear SDK?")
                (help
                    (cat
                        "Choose a location for the SDK.\n"
                        "An 'EmojiGearSDK' drawer will be created inside it.\n\n"
                        "Typical choices: Work:, SYS:Developer/, or any\n"
                        "existing NDK/SDK directory."
                    )
                )
                (default "Work:")
            )
        )
        (set #sdk-dest (tackon #sdk-parent "EmojiGearSDK"))
        (working "Creating EmojiGearSDK drawer...")
        (makedir #sdk-dest)
        (working "Copying SDK files (this may take a moment)...")
        (copyfiles
            (source "sdk")
            (dest #sdk-dest)
            (all)
        )
        (message
            (cat
                "The SDK has been installed to:\n\n"
                "  " #sdk-dest "\n\n"
                "Point your compiler's include path there and you are\n"
                "ready to build Unicode-powered Amiga applications!"
            )
        )
    )
)

(complete 95)

; ---------------------------------------------------------------------------
; EmojiGear icon (skipped if EmojiGear.info already exists so an upgrade
; never overwrites the user's saved settings)
; ---------------------------------------------------------------------------
(if (BITAND #install-apps 1)
    (if (not (exists (tackon #dest "EmojiGear.info")))
        (
            (set #icon-choice
                (askchoice
                    (prompt
                        (cat
                            "Which EmojiGear icon would you like to install?\n\n"
                            "The icon stores the default display settings in its\n"
                            "tooltypes.  You can adjust everything later from\n"
                            "EmojiGear's Settings and Font Settings menus."
                        )
                    )
                    (help
                        (cat
                            "Low-end (2 colours):\n"
                            "  Monochrome rendering, no antialiasing.\n"
                            "  Best for OCS/ECS machines or low-colour screens.\n\n"
                            "High Quality:\n"
                            "  Antialiased fonts, colour Emoji support.\n"
                            "  Recommended for AGA and RTG (Picasso, CyberGfx).\n"
                        )
                    )
                    (choices
                        "Low-end (2 colours) -- OCS/ECS friendly"
                        "High Quality -- AGA / RTG recommended"
                    )
                    (default 1)
                )
            )

            (if (= #icon-choice 0)
                (
                    (working "Installing EmojiGear icon (low-colour settings) ...")
                    (copyfiles
                        (source "bin/EmojiGearL.info")
                        (dest #dest)
                        (newname "EmojiGear.info")
                    )
                )
                (
                    (working "Installing EmojiGear icon (high-quality settings) ...")
                    (copyfiles
                        (source "bin/EmojiGearH.info")
                        (dest #dest)
                        (newname "EmojiGear.info")
                    )
                )
            )
        )
    )
)

; ---------------------------------------------------------------------------
; MUImojiGear icon (skipped if already exists)
; ---------------------------------------------------------------------------
(if (BITAND #install-apps 2)
    (if (not (exists (tackon #dest "MUImojiGear.info")))
        (
            (working "Installing MUImojiGear icon ...")
            (copyfiles
                (source "bin/MUImojiGear.info")
                (dest #dest)
            )
        )
    )
)

(complete 100)

; ---------------------------------------------------------------------------
; Done!
; ---------------------------------------------------------------------------
(exit
    (cat
        "  * * *  Installation complete!  * * *\n\n"
        "Installed in:  " #dest "\n\n"
        (if (BITAND #install-apps 1) "  EmojiGear        (requires AmigaOS 3.2+)\n" "")
        (if (BITAND #install-apps 2) "  MUImojiGear      (AmigaOS 3.0-3.9 + MUI)\n" "")
        "\n"
        "Shared components now available to all applications:\n"
        "  Libs:utf8rastport.library\n"
        "  SYS:Classes/Gadgets/unitexteditor.gadget\n"
        "  SYS:Classes/Gadgets/unibutton.gadget\n\n"
        "TrueType fonts have been placed in Fonts:."
    )
    (quiet)
)
